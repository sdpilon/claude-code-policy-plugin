{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/format-changed.sh\"",
            "timeout": 30,
            "statusMessage": "Formatting changed file"
          }
        ]
      }
    ]
  }
}
